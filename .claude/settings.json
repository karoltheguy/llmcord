{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.githooks/claude-commit-msg\"",
            "timeout": 10,
            "statusMessage": "Checking the commit subject"
          }
        ]
      }
    ]
  }
}
